# Конфігурація бази даних MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=autosalon

# Порт сервера
PORT=3000

# JWT секретний ключ (згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=generate_your_own_secret_here_64_chars_hex
